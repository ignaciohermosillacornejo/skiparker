{
  "name": "ski-parker",
  "version": "0.2.0",
  "description": "Automated HONK-based ski resort parking reservation CLI",
  "author": "Ignacio Hermosilla <hello@ignaciohermosilla.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignaciohermosillacornejo/skiparker.git"
  },
  "bugs": {
    "url": "https://github.com/ignaciohermosillacornejo/skiparker/issues"
  },
  "homepage": "https://github.com/ignaciohermosillacornejo/skiparker#readme",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "ski-parker": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run tests/lib/",
    "test:e2e": "vitest run tests/e2e/ --no-file-parallelism --test-timeout 90000",
    "test:all": "vitest run --no-file-parallelism --test-timeout 90000",
    "test:watch": "vitest",
    "test:coverage": "vitest run tests/lib/ --coverage",
    "capture": "node dist/capture-fixtures.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ski",
    "parking",
    "honk",
    "automation",
    "cli"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "node-notifier": "^10.0.1",
    "ora": "^9.1.0",
    "playwright": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@types/node-notifier": "^8.0.5",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
